---
const { sidebar, id } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build a map of directory-path -> label by walking the sidebar tree, so
// breadcrumb segments can use the same labels shown in the sidebar
// (falling back to a title-cased slug for anything not found there).
const labelsByPath = new Map<string, string>();

function collectLabels(entries: any[]) {
	for (const entry of entries) {
		if (entry.type === 'link') {
			const path = entry.href.replace(base, '').replace(/^\/|\/$/g, '');
			labelsByPath.set(path, entry.label);
		} else {
			collectLabels(entry.entries);
		}
	}
}
collectLabels(sidebar);

function titleCase(segment: string) {
	return segment.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

const segments = id.split('/').filter(Boolean);
const crumbs = segments.map((_segment: string, i: number) => {
	const path = segments.slice(0, i + 1).join('/');
	return {
		label: labelsByPath.get(path) ?? titleCase(segments[i]),
		href: `${base}/${path}/`,
	};
});

const showBreadcrumbs = crumbs.length > 0;
---

{
	showBreadcrumbs && (
		<nav class="breadcrumbs" aria-label="Breadcrumbs">
			<ol>
				<li>
					<a href={`${base}/`}>Home</a>
				</li>
				{crumbs.map((crumb, i) =>
					i === crumbs.length - 1 ? (
						<li aria-current="page">
							<span set:html={crumb.label} />
						</li>
					) : (
						<li>
							<a href={crumb.href} set:html={crumb.label} />
						</li>
					)
				)}
			</ol>
		</nav>
	)
}

<style>
	@layer starlight.components {
		.breadcrumbs {
			margin-block-end: 0.5rem;
			font-size: var(--sl-text-xs);
		}
		ol {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.4rem;
			margin: 0;
			padding: 0;
			list-style: none;
			color: var(--sl-color-gray-3);
		}
		li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}
		li:not(:first-child)::before {
			content: '/';
			color: var(--sl-color-gray-4);
		}
		a {
			color: var(--sl-color-gray-3);
			text-decoration: none;
		}
		a:hover {
			color: var(--sl-color-white);
			text-decoration: underline;
		}
		li[aria-current='page'] span {
			color: var(--sl-color-gray-2);
		}
	}
</style>
